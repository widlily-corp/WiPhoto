{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiPhoto",
  "version": "5.1.2",
  "identifier": "com.widlily.wiphoto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WiPhoto",
        "url": "index.html",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: tauri: http://asset.localhost https://tile.openstreetmap.org https://*.tile.openstreetmap.org data: blob:; media-src 'self' asset: tauri: http://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://tile.openstreetmap.org https://*.tile.openstreetmap.org; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": "powershell -ExecutionPolicy Bypass -File sign.ps1 %1"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/widlily-corp/WiPhoto/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCM0M3NzA1RDhCOTA4MDYKUldRR0NMbllCWGM4eTZxMzZrekcrdnJWbDkvQUViWFkwL2tCY2xnckdXemlUZDZkamNnVVcySUcK"
    }
  }
}